# CrownJukebox — Environment Variables
# Copy this file to .env and fill in your values

# ─── Admin ────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_use_a_strong_password

# ─── Security ─────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_random_64_char_secret

# ─── Paths ────────────────────────────────────────────
# Host path to your music folder (mounted read-only)
MUSIC_DIR=/path/to/your/music

# ─── Ports ────────────────────────────────────────────
FRONTEND_PORT=3000

# ─── Sessions ─────────────────────────────────────────
# How long sessions stay valid in hours (default 7 days)
SESSION_TTL_HOURS=168

# ─── CORS ─────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for any (development only).
# Example: ALLOWED_ORIGINS=http://192.168.1.5:3000,http://jukebox.local
ALLOWED_ORIGINS=*

# ─── Optional: Subsonic/Navidrome ─────────────────────
# SUBSONIC_URL=http://navidrome:4533
# SUBSONIC_USERNAME=admin
# SUBSONIC_PASSWORD=yourpassword
# SUBSONIC_ENABLED=false
